{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "plugins": [
    "file:///home/andre/.config/opencode/plugins/orca-opencode-status-tui/tui.js"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "verbosity": "medium",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "indicators": "status",
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal"
  },
  "scroll": {
    "acceleration": false
  },
  "terminal": {
    "title": true,
    "copy": "manual"
  }
}
